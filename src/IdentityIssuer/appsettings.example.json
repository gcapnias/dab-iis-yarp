{
  "Issuer": {
    "Url": "https://issuer.example.test",
    "Audience": "api://northwind-dab",
    "KeyId": "replace-with-a-random-key-id",
    "SigningKeyPath": "C:/secure-local-path/issuer-rsa-private.pem",
    "LifetimeMinutes": 10,
    "CookieName": "dab_access_token",
    "CookieDomain": null
  },
  "WindowsAuthentication": {
    "Mode": "Negotiate"
  },
  "ConnectionStrings": {
    "IssuerIdentity": "Server=REPLACE;Database=northwind;Encrypt=True;Integrated Security=True;TrustServerCertificate=False"
  }
}

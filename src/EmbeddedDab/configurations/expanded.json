{
  "$schema": "https://github.com/Azure/data-api-builder/releases/download/v2.0.12/dab.draft.schema.json",
  "data-source": { "database-type": "mssql", "connection-string": "@env('DAB_CONNECTION_STRING')" },
  "runtime": {
    "rest": { "enabled": true, "path": "/v2" },
    "graphql": { "enabled": true, "path": "/gql-v2", "allow-introspection": true },
    "host": { "mode": "development", "authentication": { "provider": "Unauthenticated" } }
  },
  "entities": {
    "Widget": {
      "source": { "object": "dbo.Widgets", "type": "table" },
      "rest": { "path": "catalog/widgets" },
      "graphql": true,
      "permissions": [{ "role": "anonymous", "actions": ["create", "read", "update", "delete"] }]
    },
    "Label": {
      "source": { "object": "dbo.Labels", "type": "table" },
      "rest": true,
      "graphql": true,
      "permissions": [{ "role": "anonymous", "actions": ["read"] }]
    }
  }
}
